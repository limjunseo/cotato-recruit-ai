# Local MySQL (database: recruitment_to_notion)
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/recruitment_to_notion?connection_limit=5"
# Production RDS source database (read-only recommended)
SOURCE_DATABASE_URL="mysql://readonly:YOUR_PASSWORD@YOUR_RDS_HOST:3306/recruitment?connection_limit=5"
# Optional batch sync controls
RDS_SYNC_BATCH_SIZE="200"
RDS_SYNC_MAX_BATCHES="0"
RDS_SYNC_START_AFTER_ID="0"
# Optional: protect GET /api/rds-sync (cron trigger) with bearer token
CRON_SECRET=""

# LLM provider: local | gemini
LLM_PROVIDER="local"

# Local LLM (Ollama OpenAI-compatible endpoint)
LOCAL_LLM_ENDPOINT="http://127.0.0.1:11434/v1"
LOCAL_LLM_MODEL="gemma3:12b"
# Optional for local OpenAI-compatible servers
LOCAL_LLM_API_KEY="ollama"

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Optional override
GEMINI_API_ENDPOINT="https://generativelanguage.googleapis.com/v1beta"

# Notion
NOTION_TOKEN=""
NOTION_DATABASE_ID_BE=""
NOTION_DATABASE_ID_DE=""
NOTION_DATABASE_ID_FE=""
NOTION_DATABASE_ID_PM=""

# Discord notifications (optional)
DISCORD_WEBHOOK_URL=""
DISCORD_WEBHOOK_USERNAME="Recruitment Notifier"
